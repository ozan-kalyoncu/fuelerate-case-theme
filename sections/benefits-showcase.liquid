{% liquid
  assign background_color = section.settings.background_color
  assign primary_color = section.settings.primary_color
%}
{{ 'benefits-showcase.css' | asset_url | stylesheet_tag }}
<benefits-showcase
  class="benefits-showcase"
  style="
    --benefits-background: {{ background_color }};
    --benefits-primary: {{ primary_color }};
    --benefits-secondary: #ffffff;
  "
>
  <div class="benefits-showcase__inner">

    <div class="benefits-showcase--grid">
        {% if section.settings.heading != blank or section.settings.description != blank %}
        <div class="benefits-showcase__header">

            {% if section.settings.heading != blank %}
            <h2 class="benefits-showcase__heading">
                {{ section.settings.heading }}
            </h2>
            {% endif %}

            {% if section.settings.description != blank %}
            <div class="benefits-showcase__description">
                {{ section.settings.description }}
            </div>
            {% endif %}

        </div>
        {% endif %}
        <div class="benefits-showcase__layout">
            <!-- LEFT: Tabs -->
            <div class="benefits-showcase__tabs">
                {% for block in section.blocks %}
                {% if block.settings.title != blank %}
                    <button
                    type="button"
                    class="benefits-showcase__tab{% if forloop.first %} is-active{% endif %}"
                    aria-controls="BenefitsPanel-{{ section.id }}-{{ block.id }}"
                    aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                    data-benefit-tab
                    {{ block.shopify_attributes }}
                    >
                    {% if block.settings.icon != 'none' %}
                        <span class="benefits-showcase__tab-icon">
                        {% render 'svg-icons', icon: block.settings.icon %}
                        </span>
                    {% endif %}

                    <span class="benefits-showcase__tab-title">
                        {{ block.settings.title | escape }}
                    </span>
                    </button>
                {% endif %}
                {% endfor %}
            </div>
            <!-- MIDDLE: Image -->
            <div class="benefits-showcase__media">
                {% for block in section.blocks %}
                <div
                    class="benefits-showcase__image-panel{% if forloop.first %} is-active{% endif %}"
                    data-benefit-image
                    data-panel-id="BenefitsPanel-{{ section.id }}-{{ block.id }}"
                >
                    {% if block.settings.image != blank %}
                    {{
                        block.settings.image
                        | image_url: width: 900
                        | image_tag:
                        loading: 'lazy',
                        class: 'benefits-showcase__image',
                        widths: '360, 540, 720, 900'
                    }}
                    {% endif %}
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
    <!-- RIGHT / MOBILE: Content -->
    <div class="benefits-showcase__contents">
    {% for block in section.blocks %}
        {% if block.settings.title != blank and block.settings.content != blank %}
        <div class="benefits-showcase__item">

            <!-- Accordion trigger (mobile) -->
            <button
            type="button"
            class="benefits-showcase__accordion-button{% if forloop.first %} is-active{% endif %}"
            aria-controls="BenefitsPanel-{{ section.id }}-{{ block.id }}"
            aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
            data-benefit-accordion
            >
            {% if block.settings.icon != 'none' %}
                <span class="benefits-showcase__accordion-icon">
                {% render 'svg-icons', icon: block.settings.icon %}
                </span>
            {% endif %}

            <span>{{ block.settings.title | escape }}</span>
            </button>

            <!-- Shared panel -->
            <div
            id="BenefitsPanel-{{ section.id }}-{{ block.id }}"
            class="benefits-showcase__panel{% if forloop.first %} is-active{% endif %}"
            data-benefit-panel
            {% unless forloop.first %}hidden{% endunless %}
            >
            <div class="benefits-showcase__panel-content rte">
                {{ block.settings.content }}
            </div>
            </div>

        </div>
        {% endif %}
    {% endfor %}
    </div>
  </div>
</benefits-showcase>
<script src="{{ 'benefits-showcase.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "Benefits showcase",
  "tag": "section",
  "class": "section-benefits-showcase",
  "settings": [
    {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "One Natural Solution. Whole-Body Benefits."
    },
    {
        "type": "richtext",
        "id": "description",
        "label": "Description",
        "default": "<p>Grounding supports every major system in your body, helping relieve chronic symptoms, restore balance, and promote long-term wellness.</p>"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F1EFE8"
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Primary color",
      "default": "#31331E"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "battery", "label": "Battery" },
            { "value": "stream", "label": "Stream" },
            { "value": "shield", "label": "Shield" },
            { "value": "cotton", "label": "Cotton" },
            { "value": "heart", "label": "Heart" },
            { "value": "emoji", "label": "Emoji" },
            { "value": "package", "label": "Package" },
            { "value": "flag", "label": "Flag" },
            { "value": "genetics", "label": "Genetics" },
            { "value": "hematology", "label": "Hematology" },
            { "value": "moon", "label": "Moon" },
            { "value": "strength", "label": "Strength" },
            { "value": "tree", "label": "Tree" },
            { "value": "test_tube", "label": "Test Tube" },
            { "value": "wash", "label": "Wash" }
          ],
          "default": "none"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Benefit title"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Describe the benefit here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits showcase",
      "blocks": [
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" }
      ]
    }
  ]
}
{% endschema %}