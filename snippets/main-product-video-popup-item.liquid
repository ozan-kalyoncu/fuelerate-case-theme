{% if image != blank %}
    <div class="product__video-popups--item">
        <button
            type="button"
            class="product__video-popup-trigger"
            data-video-popup-trigger
            data-video-id="VideoPopup-{{ section.id }}-{{ block.id }}-{{ index }}"
            aria-label="Open video"
        >
            {% render 'responsive-image', image: image, sizes: '240x0', classes: 'product__video-popup-image' %}
        </button>

        <div
            id="VideoPopup-{{ section.id }}-{{ block.id }}-{{ index }}"
            class="product__video-popup-modal"
            data-video-popup-modal
            hidden
        >
            <div class="product__video-popup-overlay" data-video-popup-close></div>

            <div class="product__video-popup-content" role="dialog" aria-modal="true">
                <div class="product__video-popup-close--container">
                    <button
                    type="button"
                    class="product__video-popup-close"
                    data-video-popup-close
                    aria-label="Close video"
                    >
                        ×
                    </button>
                </div>
                {{ video | video_tag: controls: true, autoplay: false, loop: enable_video_looping, class: 'product__video-popup-video' }}
            </div>
        </div>
    </div>
{% endif %}